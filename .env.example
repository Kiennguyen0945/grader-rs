# Backend (Spring Boot) — copy sang .env rồi điền giá trị thật.
# File .env KHÔNG được commit (đã có trong .gitignore).
SPRING_DATASOURCE_URL=jdbc:postgresql://grader-postgres:5432/grader
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password
SPRING_RABBITMQ_HOST=grader-rabbitmq

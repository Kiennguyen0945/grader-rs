@startuml
left to right direction
skinparam packageStyle rectangle

actor "AuthenticatedUser" as user
actor "Student" as std
actor "Lecturer" as lec
actor "Admin" as admin

std -up-|> user
lec -up-|> user
admin -up-|> user

package "Grader System" {
  ' Common / Auth
  usecase "Login" as UC_LI
  usecase "Logout" as UC_LO
  usecase "ChangePassword" as UC_CP

  ' Student Domain
  usecase "SubmitSourceCode" as UC_SSC
  usecase "ViewOwnSubmissionResults" as UC_VOSR

  ' Lecturer Domain
  usecase "ManageCourses" as UC_MC
  usecase "ManageAssignments" as UC_MA
  usecase "ManageTestCases" as UC_MTC
  usecase "ReviewStudentSubmissions" as UC_RSS
  usecase "ExportCourseResults" as UC_ECR
  usecase "ViewCourseLeaderboard" as UC_VCL
  ' Admin Domain
  usecase "ManageUsersAndPermissions" as UC_MU
}

' Actor Connections
user -- UC_LI
user -- UC_LO
user -- UC_CP

std -- UC_SSC
std -- UC_VOSR

lec -- UC_MC
lec -- UC_MA
lec -- UC_RSS
lec -- UC_ECR
lec -- UC_MTC
lec -- UC_VCL

admin -- UC_MU
@enduml




@startuml
left to right direction
package "Auth & User Management" {
  usecase "Login" as UC_LI
  usecase "Logout" as UC_LO
  usecase "ChangePassword" as UC_CP
  usecase "ManageUsersAndPermissions" as UC_MU
}

actor "Authenticated User" as user
actor "Admin" as admin
admin -up-|> user

user -- UC_LI
user -- UC_LO
user -- UC_CP
admin -- UC_MU
@enduml